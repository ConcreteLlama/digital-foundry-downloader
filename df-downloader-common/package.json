    "date-fns": "^4.1.0",
    "handlebars": "^4.7.8",
    "semver": "^7.7.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/semver": "^7.5.8",
    "rimraf": "^6.0.1",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.3.2"
  }
