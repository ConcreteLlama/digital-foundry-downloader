    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "watch": "node scripts/make-version-src.js && tsc-watch",
    "build": "node scripts/make-version-src.js && tsc",
    "start": "node dist/test.js",
    "remove": "rimraf dist && rimraf node_modules",
    "check-build": "tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
