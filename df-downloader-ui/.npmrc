# @mui/x-date-pickers (an unused optional peer of react-hook-form-mui - no
# DatePicker component is ever rendered, it's just pulled in because
# react-hook-form-mui eagerly imports it) only supports date-fns v2/v3, while
# df-downloader-common depends on date-fns v4. There's no version overlap
# possible, so npm's default (strict) peer resolution always fails here.
legacy-peer-deps=true
